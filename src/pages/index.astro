---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SegmentLanding from "@/components/SegmentLanding.astro";

export const prerender = true;

const entries = await getCollection("segments");
const entry = entries.find(
  (candidate) =>
    candidate.data.locale === "pl" && candidate.data.segment === "new_build",
);

if (!entry) throw new Error("Missing Polish new-build landing content.");

const alternates = entries
  .filter(
    (candidate) => candidate.data.translationKey === entry.data.translationKey,
  )
  .map((candidate) => ({
    locale: candidate.data.locale,
    label: candidate.data.locale.toUpperCase(),
    href:
      candidate.data.locale === "pl"
        ? "/"
        : `/${candidate.data.locale}/${candidate.data.slug}/`,
  }));
---

<BaseLayout
  locale="pl"
  title={entry.data.seo.title}
  description={entry.data.seo.description}
  alternates={alternates}
  homeHref="/"
  nav={entry.data.nav}
  footer={entry.data.footer}
>
  <SegmentLanding data={entry.data} />
</BaseLayout>
