---
import { studioCopy } from "@/content/studio";
interface Props {
  locale: "pl" | "uk" | "ru";
  notes: string[];
}
const { locale, notes } = Astro.props;
const copy = studioCopy[locale];
---

<figure class="hero-dossier">
  <figcaption class="dossier-head">
    <span>{copy.demo}</span><span class="sheet-symbol" aria-hidden="true"
    ></span>
  </figcaption>
  <div class="dossier-canvas">
    <svg viewBox="0 0 640 440" role="img" aria-label={copy.sheet}>
      <g fill="#f8f7f2" stroke="#34443e" stroke-width="5">
        <path d="M62 45H578V365H62Z"></path>
        <path
          d="M62 210H262V45M262 210H426V45M426 210H578M426 210V365M262 210V365M62 294H151V365"
        ></path>
      </g>
      <g fill="none" stroke="#8b958b" stroke-width="1.5">
        <path
          d="M262 150A60 60 0 0 0 202 210M426 150A60 60 0 0 1 486 210M262 303A62 62 0 0 0 200 365"
          stroke-dasharray="5 4"></path>
        <path d="M62 394H578M62 388V400M578 388V400"></path>
      </g>
      <g fill="#d4cfbf" stroke="#6e7b6f" stroke-width="1.5">
        <rect x="87" y="72" width="144" height="76" rx="3"></rect>
        <path d="M92 78H155V101H92ZM164 78H225V101H164Z" fill="#f7f4ed"></path>
        <rect x="285" y="70" width="115" height="35"></rect>
        <rect x="290" y="139" width="50" height="35"></rect>
        <rect x="450" y="70" width="102" height="98" rx="4" fill="#e9e6dc"
        ></rect>
        <rect x="83" y="311" width="46" height="38"></rect>
        <rect x="287" y="245" width="112" height="55" rx="5"></rect>
        <rect x="294" y="322" width="100" height="20" rx="2" fill="#b9c6b9"
        ></rect>
        <ellipse cx="503" cy="315" rx="46" ry="25" fill="#c0a88a"></ellipse>
        <path d="M472 278H491M515 278H534M472 352H491M515 352H534"></path>
      </g>
      <g fill="none" stroke="#a3543c" stroke-width="1.6">
        <path d="M106 308V267H78M346 243V190H380M505 285V241H550"></path>
      </g>
      <g
        fill="#a3543c"
        font-family="sans-serif"
        font-size="14"
        font-weight="600"
      >
        <text x="74" y="256">A</text><text x="384" y="195">B</text><text
          x="554"
          y="246">C</text
        >
      </g>
      <g fill="#164d45"
        ><circle cx="106" cy="307" r="4"></circle><circle
          cx="346"
          cy="243"
          r="4"></circle><circle cx="505" cy="285" r="4"></circle></g
      >
    </svg>
  </div>
  <ol class="dossier-notes">
    {
      notes.map((note, index) => (
        <li>
          <span>{String.fromCharCode(65 + index)}</span>
          {note}
        </li>
      ))
    }
  </ol>
  <div class="dossier-materials" aria-label={copy.palette}>
    <span class="material-chip material-chip--paper"></span><span
      class="material-chip material-chip--wood"></span><span
      class="material-chip material-chip--green"></span><p>{copy.palette}</p>
  </div>
  <p class="dossier-disclaimer">{copy.demoNote}</p>
</figure>
