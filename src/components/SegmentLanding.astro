---
import type { CollectionEntry } from "astro:content";
import FloorPlan from "@/components/FloorPlan.astro";
import HeroDossier from "@/components/HeroDossier.astro";
import LeadForm from "@/components/LeadForm.astro";
import { studioCopy } from "@/content/studio";
type Data = CollectionEntry<"segments">["data"];
const { data } = Astro.props as { data: Data };
const copy = studioCopy[data.locale];
const isMain = data.locale === "pl" && data.segment === "new_build";
const title = isMain
  ? "Zaplanuj mieszkanie, zanim zaczniesz remont."
  : data.hero.title;
const lead = isMain
  ? "Układ funkcjonalny, kierunek wnętrza i plan dalszych decyzji. Opracowane przez projektanta w 3–5 dni roboczych."
  : data.hero.lead;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-message">
      <h1 class="display">{title}</h1>
      <p class="hero-context">{data.hero.eyebrow}</p>
      <p class="hero-lead">{lead}</p>
      <ul class="hero-facts" aria-label={copy.facts}>
        <li>
          {data.package.priceLabel}
          <strong>{data.package.price} {data.package.currency}</strong>
        </li>
        <li>{data.package.duration}</li>
        <li>{data.package.included.at(-1)}</li>
      </ul>
      <div class="button-row">
        <a class="button" href="#contact"
          >{copy.cta}<span class="button-arrow" aria-hidden="true"></span></a
        >
        <a class="text-link" href="#example">{copy.example}</a>
      </div>
      <p class="hero-reassurance">{copy.intro}</p>
      <p class="hero-optional">{copy.optional}</p>
    </div>
    <HeroDossier locale={data.locale} notes={data.example.notes} />
  </div>
</section>

<section
  class="section example-section"
  id="example"
  aria-labelledby="example-title"
>
  <div class="container">
    <div class="section-heading example-heading">
      <h2 id="example-title" class="display">{copy.resultTitle}</h2>
      <div>
        <p>{data.example.text}</p><p class="demo-label">{copy.demoNote}</p>
      </div>
    </div>
    <div class="example-grid">
      <FloorPlan
        segment={data.segment}
        before={data.example.before}
        after={data.example.after}
        disclaimer={data.example.disclaimer}
      />
      <div class="example-notes">
        <h3>{data.example.title}</h3>
        <ol class="decision-list">
          {
            data.example.notes.map((note, index) => (
              <li>
                <>
                  <span aria-hidden="true">
                    {String.fromCharCode(65 + index)}
                  </span>
                  <p>{note}</p>
                </>
              </li>
            ))
          }
        </ol>
        <div class="material-direction">
          <h3>{copy.palette}</h3><div class="material-swatches">
            {
              copy.colors.map((color, index) => (
                <div>
                  <>
                    <span class={`swatch swatch--${index}`} />
                    <p>{color}</p>
                  </>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section review-section" aria-labelledby="review-title">
  <div class="container review-layout">
    <div>
      <h2 id="review-title" class="display">{copy.reviewTitle}</h2><p
        class="lede"
      >
        {copy.reviewText}
      </p><p class="disclaimer">{data.expert.aiNote}</p>
    </div>
    <div class="review-checks">
      {
        copy.checks.map((check) => (
          <article>
            <>
              <span class="check-mark" aria-hidden="true" />
              <div>
                <>
                  <h3>{check.title}</h3>
                  <p>{check.text}</p>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section suitability-section" aria-labelledby="fit-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="fit-title" class="display">{copy.suitability}</h2><p>
        {data.pains.title}
      </p>
    </div>
    <div class="pain-grid">
      {
        data.pains.items.map((item) => (
          <article class="pain-item">
            <>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section
  class="section result-section"
  id="result"
  aria-labelledby="result-title"
>
  <div class="container deliverables-layout">
    <div>
      <h2 id="result-title" class="display">{data.deliverables.title}</h2><p
        class="result-format"
      >
        PDF · {data.package.duration}
      </p>
    </div>
    <div class="deliverables-list">
      {
        data.deliverables.items.map((item) => (
          <article class="deliverable">
            <>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section" id="price" aria-labelledby="price-title">
  <div class="container package-layout">
    <div class="price-box">
      <h2 id="price-title" class="display">{data.package.title}</h2><div
        class="price"
      >
        <span>{data.package.priceLabel}</span><strong
          >{data.package.price}</strong
        ><span>{data.package.currency}</span>
      </div><p>{data.package.duration} · {data.package.included.at(-1)}</p><a
        class="button"
        href="#contact"
        >{copy.cta}<span class="button-arrow" aria-hidden="true"></span></a
      ><p class="package-note">{copy.packageNote}</p>
    </div>
    <div>
      <div class="package-columns">
        <div class="package-list">
          <h3>{data.package.includedTitle}</h3><ul>
            {data.package.included.map((item) => <li>{item}</li>)}
          </ul>
        </div><div class="package-list">
          <h3>{data.package.excludedTitle}</h3><ul>
            {data.package.excluded.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <div class="comparison-scroll">
        <table class="comparison">
          <caption>{data.comparison.title}</caption><thead
            ><tr
              ><th scope="col"><span class="sr-only">{copy.plan}</span></th><th
                scope="col">{data.comparison.express}</th
              ><th scope="col">{data.comparison.full}</th></tr
            ></thead
          ><tbody
            >{
              data.comparison.rows.map((row) => (
                <tr>
                  <>
                    <th scope="row">{row.label}</th>
                    <td>{row.express}</td>
                    <td>{row.full}</td>
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
    </div>
  </div>
</section>

<section
  class="section process-section"
  id="method"
  aria-labelledby="method-title"
>
  <div class="container">
    <h2 id="method-title" class="display section-title">
      {data.process.title}
    </h2><ol class="process-grid">
      {
        data.process.items.map((item) => (
          <li class="process-item">
            <>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq-layout">
    <h2 id="faq-title" class="display">{data.faq.title}</h2><div
      class="faq-list"
    >
      {
        data.faq.items.map((item) => (
          <details class="faq-item">
            <>
              <summary>{item.question}</summary>
              <div class="faq-answer">{item.answer}</div>
            </>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="section form-section" id="contact" aria-labelledby="form-title">
  <div class="container form-layout">
    <div>
      <h2 id="form-title" class="display">{copy.formTitle}</h2><p class="lede">
        {copy.formText}
      </p><p class="response-note">{copy.intro}</p><p class="disclaimer">
        {copy.privacy}
      </p>
    </div><LeadForm data={data} />
  </div>
</section>
<a class="mobile-contact-cta" href="#contact"
  >{copy.cta}<span class="button-arrow" aria-hidden="true"></span></a
>
